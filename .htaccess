# Редирект с http на https — ВКЛЮЧИТЬ после выпуска сертификата (Let's Encrypt
# в панели хостинга): убрать решётки у трёх строк. Без сертификата сайт уйдёт
# в ошибку. Проверку Let's Encrypt (.well-known) редирект не трогает.
RewriteEngine On
# RewriteCond %{SERVER_PORT} !^443$
# RewriteCond %{REQUEST_URI} !^/\.well-known/
# RewriteRule .* https://%{SERVER_NAME}%{REQUEST_URI} [R,L]

# Ссылки из мессенджеров: к адресу иногда прилипает знак препинания из текста
# («…/panel.html,») — такого файла нет, и человек видит 404 reg.ru. Отрезаем
# хвостовые знаки и ведём на настоящий адрес. Короткий /panel — тоже в панель.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(.*?)[,.;:!?)]+$ /$1 [R=301,L]
  RewriteRule ^panel/?$ /panel.html [R=302,L]
</IfModule>

# Служебные файлы закрыты от чужих глаз. Основная защита не здесь: файлы
# панели лежат в папке .monolit-private НАД корнем сайта, куда веб-сервер
# не ходит вовсе. Это второй рубеж — на случай хостинга, где выше корня
# писать нельзя и файлы падают рядом с сайтом.
<FilesMatch "^(published\.json|\.admin-pass|\.login-tries|data\.js\.prev|data\.js\.tmp|README\.md)$">
  Require all denied
</FilesMatch>

# На старых Apache директива выше не сработает — дублируем по-старому.
<IfModule !mod_authz_core.c>
  <FilesMatch "^(published\.json|\.admin-pass|\.login-tries|data\.js\.prev|data\.js\.tmp|README\.md)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# Панель управления не индексируем.
<IfModule mod_headers.c>
  <FilesMatch "^panel\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# Заголовки безопасности.
<IfModule mod_headers.c>
  # Браузер не должен угадывать тип файла: подсунутый под видом картинки
  # скрипт не выполнится.
  Header always set X-Content-Type-Options "nosniff"
  # Чужой сайт не сможет спрятать нашу страницу в невидимый iframe.
  Header always set X-Frame-Options "SAMEORIGIN"
  # На чужие адреса уходит только домен, без пути — партнёрские ссылки при
  # этом продолжают получать реферер, он им нужен для засчёта переходов.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# Сжатие.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Страницы не кэшируем: иначе браузер держит старый html, а тот тянет старые
# .css и .js с прежней меткой ?v= — и правки «не доезжают».
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  # PHP отдаёт каталог со своими заголовками — mod_expires не должен спорить.
  <FilesMatch "\.php$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Каталог правит клиент из панели, и версия в ссылке при этом не меняется.
  <FilesMatch "^data\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
